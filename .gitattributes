# 텍스트 파일은 저장소에 LF로 저장한다.
* text=auto eol=lf

# 바이너리로 확정 (자동 판별에 맡기지 않음)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

# 빌드 산출물과 벤더 파일은 diff/언어 통계에서 제외
css/blog.min.css    linguist-generated=true
js/blog.min.js      linguist-generated=true
js/*.min.js         linguist-vendored=true
css/bootstrap*.css  linguist-vendored=true
js/jquery*.js       linguist-vendored=true
js/bootstrap*.js    linguist-vendored=true
